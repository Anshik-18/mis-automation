# Server-side only. Never prefix with NEXT_PUBLIC_ - these must not reach the browser.

# demo = synthetic data for UI development (the default only outside production)
# live = proxy to the MIS backend API
MIS_DATA_SOURCE=demo

# Required when MIS_DATA_SOURCE=live
MIS_API_BASE_URL=http://127.0.0.1:8080
MIS_API_KEY=
