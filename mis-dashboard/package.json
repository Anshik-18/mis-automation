{
  "name": "mis-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Lead MIS analytics dashboard (Next.js + TypeScript + Tailwind CSS)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:all": "npm run typecheck && npm test",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20.9" }
}
