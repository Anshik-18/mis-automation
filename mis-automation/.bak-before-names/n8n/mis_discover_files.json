        "url": "={{ $env.MIS_NOTIFY_WEBHOOK_URL }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "73795317-39cc-5615-a9a7-02dd3f5a65f1",
      "name": "Notify Attention",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        620
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "content": "**Discovery**\nHourly. Asks the processor for the scan window (rolling lookback, or further back after downtime), lists the Drive folder page by page (createdTime filter), registers every file, then processes whatever is pending.\nNeeds: credentials *MIS Processor API Key*, *MIS Google Drive*, *MIS Webhook Secret*; env MIS_PROCESSOR_URL, MIS_DRIVE_FOLDER_ID, N8N_INTERNAL_URL. Activate *MIS - Process File* too.",
        "height": 190,
        "width": 520
      },
      "id": "940f59a7-72ad-574a-b1f2-75faccd99cc6",
      "name": "Note 18",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    }
