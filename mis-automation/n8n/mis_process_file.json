    {
      "parameters": {
        "jsCode": "// The HTTP node drops the file; put the downloaded bytes back so a mapping proposal can use them.\nconst res = $input.first().json;\nconst dl = $('Download From Drive').first();\nreturn [{ json: { ...res, event_id: $('Validate Input').first().json.event_id, filename: $('Validate Input').first().json.filename }, binary: dl.binary }];\n"
      },
