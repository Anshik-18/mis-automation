# Copy to .env (repo root) (never commit .env). Generate secrets with:  openssl rand -hex 32
POSTGRES_DB=mis
POSTGRES_USER=mis
POSTGRES_PASSWORD=change-me
PROCESSOR_API_KEY=change-me                 # shared secret n8n sends as the X-API-Key header
N8N_ENCRYPTION_KEY=change-me                # encrypts credentials stored inside n8n
MIS_DRIVE_FOLDER_ID=                        # the dedicated Google Drive folder Instinct uploads reports to

# Business behaviour
MIS_TIMEZONE=Asia/Kolkata
MIS_LOOKBACK_DAYS=3                         # rolling discovery window
MIS_OVERLAP_HOURS=6                         # extra margin when recovering after downtime
MIS_RANGE_END_FUTURE_POLICY=review          # review | clamp  (range filenames ending after the upload day)
MIS_AUTO_REGISTER_PARTNERS=false            # false: unknown 3-char codes stay 'unregistered_code' until registered
MIS_APPROVED_MIGRATIONS=002                 # additive migrations a person has approved (see README: Schema gaps)

# Optional
MIS_NOTIFY_WEBHOOK_URL=                     # Slack-style incoming webhook ({"text": "..."}); blank = no notifications
MIS_LLM_PROVIDER=none                       # none | anthropic  (only used to PROPOSE mappings for new layouts)
ANTHROPIC_API_KEY=
N8N_IMAGE_TAG=latest                        # pin to the n8n version you validated
N8N_WEBHOOK_URL=http://localhost:5678/
